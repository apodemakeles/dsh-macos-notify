{
  "name": "@apodemakeles/dsh-macos-notify",
  "version": "0.1.2",
  "description": "DeepSeek Harness (DSH) plugin: macOS turn-completion notifications and an unfocused-completion unread dot.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "macos",
    "notifications",
    "desktop-notifications",
    "turn-completion",
    "unread-badge"
  ],
  "author": "apodemakeles",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "docs/images/*.png",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apodemakeles/dsh-macos-notify.git"
  },
  "homepage": "https://github.com/apodemakeles/dsh-macos-notify#readme",
  "bugs": {
    "url": "https://github.com/apodemakeles/dsh-macos-notify/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
